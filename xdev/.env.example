# Xdev environment example
# Copy this file to .env for local development only

# ==================== GLM API (required) ====================
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_API_BASE_URL=https://open.bigmodel.cn/api/anthropic
# Compatibility aliases (optional)
# ANTHROPIC_AUTH_TOKEN=your_zhipu_api_key_here
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# ==================== Feishu settings (required) ====================
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_USE_WEBSOCKET=true

# ==================== Runtime paths (local development defaults) ====================
XDEV_HOME=/home/your-user/.xdev
# Optional: custom SQLite path; defaults to $XDEV_HOME/xdev.db when unset
# XDEV_DB=/home/your-user/.xdev/xdev.db

# ==================== Gateway / HTTP ====================
XDEV_GATEWAY_HOST=127.0.0.1
XDEV_GATEWAY_PORT=18789
XDEV_HOOKS_PORT=8081

# ==================== Model settings ====================
XDEV_MODEL=glm-5-turbo
XDEV_ROUTER_MODEL=glm-4.7-flash
XDEV_SELECTOR_MODEL=glm-4.7-flash
XDEV_BACKGROUND_MODEL=glm-4.7-flash

# ==================== Runtime settings ====================
XDEV_TIMEOUT=120000
XDEV_MAX_RETRIES=3
XDEV_RETRY_DELAY=1000
XDEV_COMPACT_THRESHOLD=5242880
XDEV_AUTO_COMPACT=true
XDEV_LOG_LEVEL=info

# ==================== Optional auth ====================
# Use a bearer token or x-xdev-token for /test/message and similar endpoints
# XDEV_API_TOKEN=change-me
