# Xdev environment example
# Copy this file to .env for local development only

# ==================== Text LLM provider ====================
# Choose one provider stack for text models: glm or deepseek
XDEV_LLM_PROVIDER=glm
# Optional one-shot preset:
#   glm-default
#   deepseek-hybrid
#   deepseek-all-pro
#   deepseek-all-flash
XDEV_MODEL_PRESET=glm-default

# Provider-neutral overrides (recommended)
# XDEV_LLM_API_KEY=your_text_llm_api_key_here
# XDEV_LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic

# GLM-specific variables
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_API_BASE_URL=https://open.bigmodel.cn/api/anthropic
# Compatibility alias (optional)
# ANTHROPIC_AUTH_TOKEN=your_zhipu_api_key_here
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# DeepSeek-specific variables
# Fill your real DeepSeek key on the next line when switching text models to DeepSeek:
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Recommended switch when enabling DeepSeek:
# XDEV_LLM_PROVIDER=deepseek
# XDEV_MODEL_PRESET=deepseek-hybrid

# ==================== Feishu settings (required) ====================
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_USE_WEBSOCKET=true

# ==================== Runtime paths (local development defaults) ====================
XDEV_HOME=/home/your-user/.xdev
# Optional: custom SQLite path; defaults to $XDEV_HOME/xdev.db when unset
# XDEV_DB=/home/your-user/.xdev/xdev.db

# ==================== Gateway / HTTP ====================
XDEV_GATEWAY_HOST=127.0.0.1
XDEV_GATEWAY_PORT=18789
XDEV_HOOKS_PORT=8081

# ==================== Model settings ====================
# Role mapping usually comes from XDEV_MODEL_PRESET.
# Leave the explicit overrides below commented out unless you intentionally want to replace the preset.
# XDEV_MODEL=glm-5-turbo
# XDEV_ROUTER_MODEL=glm-4.7-flash
# XDEV_SELECTOR_MODEL=glm-4.7-flash
# XDEV_BACKGROUND_MODEL=glm-4.7-flash
# XDEV_CODER_MODEL=glm-5
# XDEV_AUX_MODEL=glm-4.7-flash
# XDEV_FALLBACK_MODEL=glm-4.7-flash

# ==================== Vision settings ====================
# Vision stays on GLM by default even when text uses DeepSeek
# XDEV_VISION_API_KEY=your_zhipu_api_key_here
# XDEV_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# XDEV_VISION_MODEL=glm-5v-turbo

# ==================== Runtime settings ====================
XDEV_TIMEOUT=120000
XDEV_MAX_RETRIES=3
XDEV_RETRY_DELAY=1000
XDEV_COMPACT_THRESHOLD=5242880
XDEV_AUTO_COMPACT=true
XDEV_LOG_LEVEL=info

# ==================== Optional auth ====================
# Use a bearer token or x-xdev-token for /test/message and similar endpoints
# XDEV_API_TOKEN=change-me
