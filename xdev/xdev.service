# /etc/systemd/system/xdev.service
# Xdev systemd service unit

[Unit]
Description=Xdev service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xdev
Group=xdev
WorkingDirectory=/opt/xdev
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/xdev/dist/index.js
Restart=on-failure
RestartSec=5

# Environment
EnvironmentFile=/etc/xdev/environment

# Resource limits
LimitNOFILE=65535
MemoryMax=2G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xdev

[Install]
WantedBy=multi-user.target
