# 小智环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== 飞书配置（必需）====================
# 飞书应用 ID（通常以 cli_ 开头）
FEISHU_APP_ID=cli_xxxxxxxxxx
# 飞书应用密钥
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ==================== Gateway 配置 ====================
# Gateway 监听地址
XIAOZHI_GATEWAY_HOST=127.0.0.1
# Gateway 端口
XIAOZHI_GATEWAY_PORT=18789

# ==================== HTTP 配置 ====================
# HTTP 接收器端口（专家回调）
XIAOZHI_HOOKS_PORT=8081

# ==================== 模型配置 ====================
# Claude 模型（可选，默认使用 settings.json 中的配置）
# XIAOZHI_MODEL=claude-sonnet-4-6

# ==================== 性能配置 ====================
# 请求超时（毫秒）
XIAOZHI_TIMEOUT=120000
# 最大重试次数
XIAOZHI_MAX_RETRIES=3
# 重试延迟（毫秒）
XIAOZHI_RETRY_DELAY=1000
# 最大并发专家数
XIAOZHI_MAX_CONCURRENT=5
# 专家默认超时（毫秒）
XIAOZHI_DEFAULT_TIMEOUT=1800000

# ==================== 上下文配置 ====================
# 压缩阈值（字节）
XIAOZHI_COMPACT_THRESHOLD=5242880
# 是否自动压缩
XIAOZHI_AUTO_COMPACT=true

# ==================== 日志配置 ====================
# 日志级别：debug, info, warn, error
LOG_LEVEL=info
